# Copy to .env to override defaults used by compose.yaml.

# LLM provider for the llm module: ollama | fake
KB_LLM_PROVIDER=ollama
# Seconds the fake provider waits per word, to watch or stop a streaming answer.
# KB_FAKE_TOKEN_DELAY=0.3
# Ollama in compose (`task up -- --profile ollama`) or on the host:
KB_OLLAMA_URL=http://ollama:11434
# KB_OLLAMA_URL=http://host.docker.internal:11434
KB_CHAT_MODEL=llama3.2
KB_EMBEDDING_MODEL=nomic-embed-text
# Must match the vector(...) column in modules/document/migrations.
KB_EMBEDDING_DIMENSIONS=768
# Chunks are measured in tokens of the embedding model's tokenizer; change these
# together with KB_EMBEDDING_MODEL. KB_CHUNK_TOKENIZER is a tokenizer bundled with
# the ingestion worker (nomic-embed-text) or the path of a Hugging Face
# tokenizer.json inside its container. KB_EMBEDDING_MAX_TOKENS is the model's
# input limit (special tokens included); the worker refuses chunk sizes above it.
KB_CHUNK_TOKENIZER=nomic-embed-text
KB_CHUNK_TOKENS=256
KB_CHUNK_OVERLAP_TOKENS=32
KB_EMBEDDING_MAX_TOKENS=2048
# Similarity a passage needs to be used as a chat source; tuned for nomic-embed-text.
# Cosine similarity, -1 to 1. The fake provider's hash embeddings need -1 (keep
# every passage), or answers get no sources.
KB_RAG_MIN_SCORE=0.5

# Host ports of the browser-facing services.
KB_GATEWAY_PORT=8080
KB_WEB_PORT=3000

# Addresses the browser uses (keep in sync with the ports above).
KB_API_BASE_URL=http://localhost:8080
KB_S3_PUBLIC_ENDPOINT=localhost:8333

# Comma-separated module ids to show in the UI (empty = all).
KB_ENABLED_MODULES=
