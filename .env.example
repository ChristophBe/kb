# Copy to .env to override defaults used by compose.yaml. Every variable, with
# its default and description: docs/configuration.md.
# The former KB_* names still work for one release (with a warning); rename them to KNOWCEL_*.

# LLM provider for the llm module: ollama | anthropic | openai | fake
KNOWCEL_LLM_PROVIDER=ollama
# Pick one per task instead; each falls back to KNOWCEL_LLM_PROVIDER when empty.
# E.g. Claude chat with local Ollama embeddings:
# KNOWCEL_CHAT_PROVIDER=anthropic
# KNOWCEL_EMBEDDING_PROVIDER=ollama
# Seconds the fake provider waits per word, to watch or stop a streaming answer.
# KNOWCEL_FAKE_TOKEN_DELAY=0.3
# Embedding model name the fake provider reports; change it to try out a model
# change (docs/operations/embedding-model.md).
# KNOWCEL_FAKE_EMBEDDING_MODEL=fake-embed
# Ollama in compose (`task up -- --profile ollama`) or on the host:
KNOWCEL_OLLAMA_URL=http://ollama:11434
# KNOWCEL_OLLAMA_URL=http://host.docker.internal:11434
KNOWCEL_CHAT_MODEL=llama3.2
KNOWCEL_EMBEDDING_MODEL=nomic-embed-text
# Anthropic (Claude), chat only: it has no embedding models, so pair it with
# KNOWCEL_EMBEDDING_PROVIDER=ollama (the llm service refuses to start otherwise).
# Required for anthropic:
# KNOWCEL_ANTHROPIC_API_KEY=sk-ant-...
# claude-opus-5-5 | claude-sonnet-5-5 | claude-haiku-5-5 | claude-fable-5-1
# KNOWCEL_ANTHROPIC_CHAT_MODEL=claude-sonnet-5-5
# KNOWCEL_ANTHROPIC_MAX_TOKENS=16000

# OpenAI-compatible API (chat and embeddings): OpenAI itself or a local server
# such as LM Studio (http://host.docker.internal:1234/v1) or vLLM. The key is
# only needed for servers that check one (always for api.openai.com).
# KNOWCEL_OPENAI_URL=https://api.openai.com/v1
# KNOWCEL_OPENAI_API_KEY=sk-...
# KNOWCEL_OPENAI_CHAT_MODEL=gpt-4o-mini
# KNOWCEL_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# A server that rejects the `dimensions` parameter needs an embedding model
# that already produces KNOWCEL_EMBEDDING_DIMENSIONS (768) values:
# KNOWCEL_OPENAI_SEND_DIMENSIONS=false
# Must match the vector(...) column in modules/document/migrations.
KNOWCEL_EMBEDDING_DIMENSIONS=768
# Chunks are measured in tokens of the embedding model's tokenizer; change these
# together with KNOWCEL_EMBEDDING_MODEL. KNOWCEL_CHUNK_TOKENIZER is a tokenizer bundled with
# the ingestion worker (nomic-embed-text) or the path of a Hugging Face
# tokenizer.json inside its container. KNOWCEL_EMBEDDING_MAX_TOKENS is the model's
# input limit (special tokens included); the worker refuses chunk sizes above it.
KNOWCEL_CHUNK_TOKENIZER=nomic-embed-text
KNOWCEL_CHUNK_TOKENS=256
KNOWCEL_CHUNK_OVERLAP_TOKENS=32
KNOWCEL_EMBEDDING_MAX_TOKENS=2048
# Read scanned PDF pages (no text layer) with Tesseract OCR; slow, so off by default.
# KNOWCEL_OCR_LANGUAGES are Tesseract language codes joined with "+" (eng+deu); the
# worker image ships English only, add tesseract-ocr-<code> packages for more.
KNOWCEL_OCR_ENABLED=false
KNOWCEL_OCR_LANGUAGES=eng
# Documents the ingestion worker processes at the same time. Raise it when the
# embedding model serves requests in parallel (GPU, hosted provider, Ollama with
# OLLAMA_NUM_PARALLEL); a CPU-only model works through them one by one anyway.
KNOWCEL_WORKER_CONCURRENCY=2
# Similarity a passage needs to be used as a chat source; tuned for nomic-embed-text.
# Cosine similarity, -1 to 1. The fake provider's hash embeddings need -1 (keep
# every passage), or answers get no sources.
KNOWCEL_RAG_MIN_SCORE=0.5
# Uploads the document service accepts: the largest file in bytes (50 MiB; the
# ingestion worker holds a whole file and its text in memory) and the content
# types, comma-separated, "text/*" for all of a kind. The default types are the
# ones the ingestion worker can extract text from.
KNOWCEL_MAX_UPLOAD_BYTES=52428800
KNOWCEL_ALLOWED_CONTENT_TYPES=application/pdf,text/*,application/json,application/yaml,application/x-yaml,application/vnd.openxmlformats-officedocument.wordprocessingml.document
# Cleanup in the document service, every KNOWCEL_CLEANUP_INTERVAL (0 turns it off):
# documents whose upload hasn't completed after KNOWCEL_UPLOAD_TTL are removed (keep
# it above the 15 minutes upload URLs stay valid), and files in the bucket that
# no document refers to once they are older than KNOWCEL_ORPHAN_GRACE. Go durations.
KNOWCEL_CLEANUP_INTERVAL=1h
KNOWCEL_UPLOAD_TTL=24h
KNOWCEL_ORPHAN_GRACE=1h

# Host port of the gRPC-Web gateway (Envoy).
KNOWCEL_GATEWAY_PORT=8080
# Host port of the web shell.
KNOWCEL_WEB_PORT=3000
# Port of the Vite dev server (task web); Dex allows it as a redirect URI.
KNOWCEL_WEB_DEV_PORT=5173

# Addresses the browser uses (keep in sync with the ports above): the gateway
# the web shell calls, and the object store upload and download URLs point at.
KNOWCEL_API_BASE_URL=http://localhost:8080
KNOWCEL_S3_PUBLIC_ENDPOINT=localhost:8333

# Host port of the dev Dex identity provider.
KNOWCEL_DEX_PORT=5556
# OIDC issuer whose tokens the gateway accepts (the `iss` claim; browsers and
# tests fetch tokens there). Defaults to the dev Dex; with another KNOWCEL_DEX_PORT
# change the issuer's port too.
KNOWCEL_OIDC_ISSUER=http://localhost:5556/dex
# Where Envoy fetches the issuer's signing keys (http or https).
KNOWCEL_OIDC_JWKS_URL=http://dex:5556/dex/keys
# The web shell's client id at the issuer (authorization code with PKCE).
KNOWCEL_OIDC_CLIENT_ID=kb-web
# Client ids (token audiences) the gateway accepts, comma-separated.
KNOWCEL_OIDC_AUDIENCES=kb-web,kb-cli

# Tracing (docs/operations/observability.md): off while KNOWCEL_OTEL_ENDPOINT is
# empty. The `observability` profile runs a collector and Jaeger to send to;
# activate it with --profile observability or COMPOSE_PROFILES.
# KNOWCEL_OTEL_ENDPOINT=http://otel-collector:4317
# COMPOSE_PROFILES=observability
# Host port of the Jaeger UI (observability profile).
# KNOWCEL_JAEGER_PORT=16686
# Host port of the collector's OTLP/gRPC receiver (observability profile).
# KNOWCEL_OTEL_GRPC_PORT=4317
# The same profile runs Prometheus, which scrapes every component's /metrics
# (docs/metrics.md). Each component serves its metrics on KNOWCEL_METRICS_PORT
# (default: metrics_port in its module.yaml).

# Host port of the Prometheus UI (observability profile).
# KNOWCEL_PROMETHEUS_PORT=9090

# Comma-separated module ids to show in the UI (empty = all).
KNOWCEL_ENABLED_MODULES=

# Version the images are built as and report (the web shell logs it at start);
# deploy/release.compose.yaml requires a released one, e.g. 0.3.1.
# KNOWCEL_VERSION=dev
