{
  "name": "kb",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "pnpm --filter @kb/web dev",
    "build": "pnpm --filter @kb/web build",
    "site": "pnpm --filter @kb/site dev",
    "site:build": "pnpm --filter @kb/site build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@bufbuild/protoc-gen-es": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
