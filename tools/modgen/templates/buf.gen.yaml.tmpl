# Code generated by modgen from module.yaml. DO NOT EDIT.
# Run from the repository root: buf generate --template {{.Pkg.Dir}}/buf.gen.yaml
version: v2
clean: true
inputs:
  - directory: .
    paths:
      - {{.Pkg.Dir}}/proto/kb
plugins:
  - local: [go, tool, -modfile=tools/go.mod, protoc-gen-go]
    out: {{.Pkg.Dir}}/api/go
    opt: [module={{.GoModule}}/{{.Pkg.Dir}}/api/go]
  - local: [go, tool, -modfile=tools/go.mod, protoc-gen-go-grpc]
    out: {{.Pkg.Dir}}/api/go
    opt: [module={{.GoModule}}/{{.Pkg.Dir}}/api/go]
  - local: [uv, run, --quiet, python, tools/protoc-gen-kbpy/main.py]
    out: {{.Pkg.Dir}}/api/python/src
  - local: node_modules/.bin/protoc-gen-es
    out: {{.Pkg.Dir}}/api/ts/src
    opt:
      - target=ts
{{- if not .Pkg.Common}}
      - rewrite_imports=./kb/common/**/*_pb.js:@kb/common-api
{{- end}}
