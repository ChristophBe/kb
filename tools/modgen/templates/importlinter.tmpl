# Code generated by modgen from modules/*/module.yaml. DO NOT EDIT.
# Edit tools/modgen/templates/importlinter.tmpl instead.
#
# Module boundaries for Python (docs/architecture/module.md), checked by
# `lint-imports` in `task lint`.
[importlinter]
root_packages =
    kb
    {{.PyPlatform}}
{{- range .Modules}}{{range .PyPackages}}
    {{.}}
{{- end}}{{end}}
{{- if .PyForbid}}

[importlinter:contract:platform]
name = platform/ never imports a module
type = forbidden
source_modules =
    {{.PyPlatform}}
forbidden_modules =
{{- range .PyForbid}}
    {{.}}
{{- end}}
{{- end}}
{{- range .Boundaries}}{{if and .PySources .PyForbidden}}

[importlinter:contract:module-{{.ID}}]
name = {{.ID}} imports only its own code, platform/ and the api/ of modules in depends_on
type = forbidden
source_modules =
{{- range .PySources}}
    {{.}}
{{- end}}
forbidden_modules =
{{- range .PyForbidden}}
    {{.}}
{{- end}}
{{- end}}{{end}}
