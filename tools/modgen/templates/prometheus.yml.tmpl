# Code generated by modgen from modules/*/module.yaml. DO NOT EDIT.
# Prometheus of the `observability` compose profile
# (docs/operations/observability.md): scrapes every module component's
# /metrics (metrics_port in its module.yaml) on the compose network.
# Metric names: docs/metrics.md.
global:
  scrape_interval: 15s

scrape_configs:
{{- range .Modules}}{{$m := .}}{{range .Services}}
  - job_name: {{.Name}}
    static_configs:
      - targets: ["{{.Name}}:{{.MetricsPort}}"]
        labels: { module: {{$m.ID}} }
{{- end}}{{end}}
