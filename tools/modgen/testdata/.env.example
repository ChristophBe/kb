# Copy to .env.

# Host port of the gateway.
KNOWCEL_GATEWAY_PORT=8080

# OIDC issuer the gateway trusts.
KNOWCEL_OIDC_ISSUER=http://localhost:5556/dex
# OTHER_TOOL=1
# Version of the images.
# KNOWCEL_VERSION=dev

# Addresses the browser uses.
KNOWCEL_API_BASE_URL=http://localhost:8080
KNOWCEL_ENABLED_MODULES=
